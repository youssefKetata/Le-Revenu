{
  "name": "le-revenu",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "demo": "node scripts/demo.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "test:api": "node --test --test-concurrency=1 scripts/forum-api.test.mjs",
    "test:frontend": "node --test --test-concurrency=1 scripts/frontend.test.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "db:check": "node scripts/check-database.mjs",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run develop",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "start:frontend": "npm --prefix frontend run start",
    "start:backend": "npm --prefix backend run start",
    "lint:frontend": "npm --prefix frontend run lint",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "typecheck:backend": "npm --prefix backend run typecheck"
  }
}
