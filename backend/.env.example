# Local HTTP server
HOST=127.0.0.1
PORT=1337
FRONTEND_URL=http://localhost:3000

# Run npm run setup:env at the repository root to generate real local values.
APP_KEYS=GENERATE_APP_KEYS
API_TOKEN_SALT=GENERATE_SECRET
ADMIN_JWT_SECRET=GENERATE_SECRET
TRANSFER_TOKEN_SALT=GENERATE_SECRET
JWT_SECRET=GENERATE_SECRET
ENCRYPTION_KEY=GENERATE_SECRET

# Use the existing local PostgreSQL service and a dedicated application database.
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=le_revenu
DATABASE_USERNAME=le_revenu
DATABASE_PASSWORD=GENERATE_SECRET
DATABASE_SSL=false
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=3

# Local forum members created by npm run seed:demo. Never commit real passwords.
DEMO_CAMILLE_PASSWORD=GENERATE_SECRET
DEMO_THOMAS_PASSWORD=GENERATE_SECRET

# Disable local telemetry. Update checks are disabled in config/server.ts.
STRAPI_TELEMETRY_DISABLED=true
